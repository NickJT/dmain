.{
    .name = .tui,
    .version = "0.0.0",
    .fingerprint = 0xca9f4dd1a561f312, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // `view` needs ansi's escape sequences and local_time's wall clock.
        // A path dependency, like every other cross-package reference here:
        // a library change and its callers land in one commit, so there is never a
        // version to skew.
        .util = .{ .path = "../util" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
