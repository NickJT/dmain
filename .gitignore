# Build output — all of it regenerated by `zig build` or `swift build`.
.zig-cache/
zig-out/
.build/
.swiftpm/

# Secrets, made on the host that runs the program and never committed.
# The Zigbee network key and the coordinator's saved state:
hub-coordinator.json
hub-coordinator-*.json
# The Hue Bridge's application key:
bridge.json
huelog.json

# Runtime output.
*.log
*.tmp
data/
backups/
hub.sock

# macOS
.DS_Store
